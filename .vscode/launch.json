{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chạy ví dụ Poisson",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/poisson_demo.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "justMyCode": true,
      "env": {
        "PYTHONUTF8": "1"
      }
    }
  ]
}
